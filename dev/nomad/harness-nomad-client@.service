[Unit]
Description=Harness Nomad development client (%i)

[Service]
Type=exec
RuntimeDirectory=hn-%i
RuntimeDirectoryMode=0700
# cluster.sh writes a drop-in that sets HARNESS_NOMAD_DIR to this checkout's
# dev/nomad directory. It avoids %Y, which requires systemd 254 or later.
ExecStartPre=/bin/sh -c 'exec docker compose --project-name harness-nomad-%i --file "$HARNESS_NOMAD_DIR/compose.yaml" cp server:/bin/nomad %t/hn-%i/nomad'
ExecStart=%t/hn-%i/nomad agent -node=harness-nomad-%i-client -data-dir=%t/hn-%i/data -config=${HARNESS_NOMAD_DIR}/client.hcl
